+			f := &o.reject.flows[index]
+			f.started = name != "not_started"
+			sample := *f
+			if name == "old_icmp" {
+				oldToken := bytes.Clone(o.reject.health.token)
+				o.reject.active = false
+				if err := o.beginRejectPhase(2); err != nil {
+					t.Fatal(err)
