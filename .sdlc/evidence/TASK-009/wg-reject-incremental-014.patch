+					bad.payload[16] = 2
+					raw = localPacket(bad, false, 10, 2, bad.payload[:])
+				}
+				if name == "wrong_tuple" {
+					bad := sample
+					bad.destination = [4]byte{198, 18, 0, 3}
+					raw = localPacket(bad, false, 10, 2, nil)
+				}
+				if name == "wrong_checksum" {
+					raw[10] ^= 1
+				}
+				if name == "late_phase" {
+					o.reject.active = false
