+        fn remaining(deadline: Instant, limit: Duration) -> Result<Duration, &'static str> {
+            deadline
+                .checked_duration_since(Instant::now())
+                .filter(|time| !time.is_zero())
+                .map(|time| time.min(limit))
+                .ok_or("peer absolute deadline")
+        }
