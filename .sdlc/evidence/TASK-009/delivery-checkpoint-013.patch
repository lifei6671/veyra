+            getrandom::fill(&mut peer_private).expect("peer key entropy");
+            for key in [&mut dut_private, &mut peer_private] {
+                key[0] &= 248;
+                key[31] &= 127;
+                key[31] |= 64;
+            }
+            let hex = |bytes: &[u8]| {
+                bytes
+                    .iter()
+                    .map(|byte| format!("{byte:02x}"))
+                    .collect::<String>()
+            };
