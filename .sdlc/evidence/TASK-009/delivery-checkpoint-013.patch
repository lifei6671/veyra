+            start();
+            let Trace::Delta(1, ready, [0, 0]) = traces
+                .recv_timeout(STOP_RESPONSE_TIMEOUT)
+                .expect("first Ready delta")
+            else {
+                panic!("Ready precedes stream operations")
+            };
