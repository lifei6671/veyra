+        impl PeerStage {
+            fn after_command(self, op: &str) -> Result<Self, &'static str> {
+                match (self, op) {
+                    (Self::InitTcp, "init") => Ok(Self::ReadyTcp),
+                    (Self::InitUdp, "init_udp") => Ok(Self::ReadyUdp),
+                    (Self::ProbeIcmp, "probe_icmp") => Ok(Self::Icmp),
