{
  "log": {
    "disabled": false,
    "level": "info"
  },
  "dns": {
    "strategy": "prefer_ipv4",
    "servers": [
      {
        "server": "127.0.0.1",
        "server_port": 53,
        "type": "udp",
        "tag": "dns-direct"
      },
      {
        "server": "::1",
        "server_port": 53,
        "detour": "pool-auto",
        "type": "udp",
        "tag": "dns-proxy-pool-auto"
      },
      {
        "server": "::1",
        "server_port": 53,
        "detour": "pool-manual",
        "type": "udp",
        "tag": "dns-proxy"
      }
    ],
    "final": "dns-proxy",
    "rules": [
      {
        "server": "dns-direct",
        "action": "route",
        "domain": [
          "node.example.invalid",
          "subscription.example.invalid"
        ]
      },
      {
        "server": "dns-direct",
        "action": "route",
        "domain_suffix": [
          "direct.example.invalid"
        ]
      },
      {
        "server": "dns-proxy-pool-auto",
        "action": "route",
        "domain_suffix": [
          "proxy.example.invalid"
        ]
      },
      {
        "action": "reject",
        "domain_suffix": [
          "block.example.invalid"
        ]
      }
    ]
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 0
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "node-a",
      "server": "127.0.0.1",
      "server_port": 20000,
      "version": "5"
    },
    {
      "type": "socks",
      "tag": "node-b",
      "server": "node.example.invalid",
      "server_port": 20000,
      "version": "5"
    },
    {
      "type": "socks",
      "tag": "node-c",
      "server": "::1",
      "server_port": 20000,
      "version": "5"
    },
    {
      "type": "urltest",
      "tag": "pool-auto",
      "outbounds": [
        "node-a",
        "node-b",
        "node-c"
      ],
      "url": "http://127.0.0.1:20001/pool",
      "interval": "120s",
      "tolerance": 80
    },
    {
      "type": "selector",
      "tag": "pool-manual",
      "outbounds": [
        "node-a",
        "node-b",
        "node-c"
      ],
      "default": "node-a"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "outbound": "direct",
        "domain": [
          "node.example.invalid",
          "subscription.example.invalid"
        ]
      },
      {
        "outbound": "direct",
        "ip_cidr": [
          "127.0.0.1/32",
          "::1/128"
        ]
      },
      {
        "outbound": "direct",
        "domain_suffix": [
          "direct.example.invalid"
        ]
      },
      {
        "action": "reject",
        "domain_suffix": [
          "proxy.example.invalid"
        ],
        "port": [
          443
        ],
        "network": [
          "udp"
        ]
      },
      {
        "outbound": "pool-auto",
        "domain_suffix": [
          "proxy.example.invalid"
        ]
      },
      {
        "action": "reject",
        "domain_suffix": [
          "block.example.invalid"
        ]
      },
      {
        "action": "reject",
        "port": [
          443
        ],
        "network": [
          "udp"
        ]
      }
    ],
    "final": "pool-manual",
    "default_domain_resolver": "dns-direct"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/tmp/veyra-product/profile-v114/cache.db",
      "cache_id": "profile-v114",
      "store_fakeip": false,
      "store_dns": false
    },
    "clash_api": {
      "external_controller": "127.0.0.1:0",
      "secret": "<runtime-secret>"
    }
  }
}
