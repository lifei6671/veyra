[
  {
    "name": "core-check",
    "command": [
      "cargo",
      "check",
      "-p",
      "veyra-core"
    ],
    "timeout": 600,
    "exit": 0
  },
  {
    "name": "core-build",
    "command": [
      "cargo",
      "build",
      "-p",
      "veyra-core",
      "--lib"
    ],
    "timeout": 600,
    "exit": 0
  },
  {
    "name": "core-tests",
    "command": [
      "cargo",
      "test",
      "-p",
      "veyra-core",
      "--lib",
      "--",
      "--test-threads=1"
    ],
    "timeout": 600,
    "exit": 0
  },
  {
    "name": "core-clippy",
    "command": [
      "cargo",
      "clippy",
      "-p",
      "veyra-core",
      "--lib",
      "--",
      "-D",
      "warnings"
    ],
    "timeout": 600,
    "exit": 0
  },
  {
    "name": "legacy-check",
    "command": [
      "cargo",
      "check",
      "--manifest-path",
      "src-tauri/Cargo.toml",
      "--all-targets"
    ],
    "timeout": 900,
    "exit": 101
  }
]
