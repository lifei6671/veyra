{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "仅允许主窗口调用固定的启动信息、订阅、观测快照、受管观测运行时启动/停止与窗口恢复命令。",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-bootstrap-status",
    "allow-runtime-observation-snapshot",
    "allow-start-managed-observation-runtime",
    "allow-stop-managed-observation-runtime",
    "allow-show-main-window",
    "allow-list-subscriptions",
    "allow-import-subscription",
    "allow-update-subscription",
    "allow-get-subscription-settings",
    "allow-edit-subscription",
    "allow-activate-subscription",
    "allow-get-subscription-share-url",
    "allow-delete-subscription",
    "allow-get-subscription-document",
    "allow-format-subscription-document",
    "allow-save-subscription-document",
    "allow-get-running-configuration",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
