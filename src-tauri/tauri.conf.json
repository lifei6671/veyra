{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veyra",
  "version": "0.1.0",
  "identifier": "com.lifei6671.veyra",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veyra",
        "width": 960,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/sing-box-1.14.0-windows-amd64/sing-box.exe": "sing-box/1.14.0/sing-box.exe",
      "binaries/sing-box-1.14.0-windows-amd64/libcronet.dll": "sing-box/1.14.0/libcronet.dll",
      "binaries/sing-box-1.14.0-windows-amd64/LICENSE": "sing-box/1.14.0/LICENSE"
    }
  }
}
